{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/phase4-analysis-v1.1-2026-07-19.json",
  "title": "Phase 4 APK protocol analysis",
  "type": "object",
  "required": [
    "schema_revision",
    "status",
    "artifact",
    "analyst",
    "tool_coverage",
    "application_stacks",
    "variant_inventory",
    "candidate_ledger",
    "protocols",
    "evidence",
    "completion_gates",
    "limitations",
    "deferred_external_validation"
  ],
  "properties": {
    "schema_revision": {
      "const": "phase4-analysis-v1.1-2026-07-19"
    },
    "status": {
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "INPUT_MISMATCH"]
    },
    "artifact": {
      "type": "object",
      "required": [
        "app_name",
        "package_id",
        "version_name",
        "version_code",
        "artifact_set_sha256",
        "files",
        "signer_certificate_sha256",
        "source"
      ],
      "properties": {
        "app_name": {"type": "string"},
        "package_id": {"type": "string"},
        "version_name": {"type": "string"},
        "version_code": {"type": "string"},
        "artifact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "size", "sha256"],
            "properties": {
              "file": {"type": "string"},
              "size": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": true
          }
        },
        "signer_certificate_sha256": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "analyst": {
      "type": "object",
      "required": ["identity", "prompt_revision", "started_at", "completed_at"],
      "additionalProperties": true
    },
    "tool_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "version", "purpose", "status"],
        "additionalProperties": true
      }
    },
    "application_stacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stack", "present", "coverage", "evidence"],
        "additionalProperties": true
      }
    },
    "variant_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "selector", "source", "disposition"],
        "additionalProperties": true
      }
    },
    "candidate_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "source", "disposition", "evidence"],
        "additionalProperties": true
      }
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reachability",
          "selectors",
          "gatt",
          "packet_format",
          "commands",
          "timing",
          "release_behavior",
          "evidence"
        ],
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "paths"],
        "additionalProperties": true
      }
    },
    "completion_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "result", "evidence"],
        "properties": {
          "result": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "deferred_external_validation": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "COMPLETE"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completion_gates": {
            "items": {
              "properties": {
                "result": {"enum": ["PASS", "NOT_APPLICABLE"]}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
