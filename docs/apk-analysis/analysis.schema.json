{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/phase4-analysis-v1.3-2026-07-26.json",
  "title": "Phase 4 APK protocol analysis",
  "type": "object",
  "required": [
    "schema_revision",
    "status",
    "artifact",
    "analyst",
    "tool_coverage",
    "application_stacks",
    "variant_inventory",
    "candidate_ledger",
    "protocols",
    "test_vectors",
    "evidence",
    "completion_gates",
    "limitations",
    "blockers",
    "deferred_external_validation"
  ],
  "properties": {
    "schema_revision": {
      "const": "phase4-analysis-v1.3-2026-07-26"
    },
    "status": {
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "INPUT_MISMATCH"]
    },
    "artifact": {
      "type": "object",
      "required": [
        "app_name",
        "package_id",
        "version_name",
        "version_code",
        "artifact_set_sha256",
        "files",
        "signer_certificate_sha256",
        "source"
      ],
      "properties": {
        "app_name": {"type": "string"},
        "package_id": {"type": "string"},
        "version_name": {"type": "string"},
        "version_code": {"type": "string"},
        "artifact_set_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "size", "sha256"],
            "properties": {
              "file": {"type": "string"},
              "size": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": true
          }
        },
        "signer_certificate_sha256": {
          "comment": "Nullable so an INPUT_MISMATCH report can be truthful about a corrupt or unsigned artifact that yields no certificate hash. The not-INPUT_MISMATCH branch below restores the strict requirement for every artifact that did verify.",
          "type": ["array", "null"],
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "analyst": {
      "type": "object",
      "required": ["identity", "prompt_revision", "started_at", "completed_at"],
      "additionalProperties": true
    },
    "tool_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "version", "purpose", "status"],
        "additionalProperties": true
      }
    },
    "application_stacks": {
      "comment": "No minimum here: an INPUT_MISMATCH run stops at Phase A step 1, before it may inventory stacks. The not-INPUT_MISMATCH branch below requires at least one entry for every run that got past identity verification.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stack", "present", "coverage", "evidence"],
        "additionalProperties": true
      }
    },
    "variant_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "selector", "source", "disposition"],
        "additionalProperties": true
      }
    },
    "candidate_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "source", "disposition", "evidence"],
        "additionalProperties": true
      }
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reachability",
          "selectors",
          "discovery_rules",
          "gatt",
          "session_sequence",
          "packet_format",
          "commands",
          "notifications",
          "capabilities",
          "model_mappings",
          "timing",
          "release_behavior",
          "evidence"
        ],
        "comment": "Null is allowed throughout because the prompt requires an unknown to be reported as null with an explanation rather than omitted. What is rejected is a wrong shape, such as a scalar where the report promises a table, and a bare null with no stated reason: each nullable section below carries a required <field>_unknown_reason companion, so an exhaustively searched absence stays distinguishable from an unexamined gap.",
        "allOf": [
          {"if": {"properties": {"selectors": {"type": "null"}}, "required": ["selectors"]}, "then": {"required": ["selectors_unknown_reason"]}},
          {"if": {"properties": {"discovery_rules": {"type": "null"}}, "required": ["discovery_rules"]}, "then": {"required": ["discovery_rules_unknown_reason"]}},
          {"if": {"properties": {"gatt": {"type": "null"}}, "required": ["gatt"]}, "then": {"required": ["gatt_unknown_reason"]}},
          {"if": {"properties": {"session_sequence": {"type": "null"}}, "required": ["session_sequence"]}, "then": {"required": ["session_sequence_unknown_reason"]}},
          {"if": {"properties": {"packet_format": {"type": "null"}}, "required": ["packet_format"]}, "then": {"required": ["packet_format_unknown_reason"]}},
          {"if": {"properties": {"commands": {"type": "null"}}, "required": ["commands"]}, "then": {"required": ["commands_unknown_reason"]}},
          {"if": {"properties": {"notifications": {"type": "null"}}, "required": ["notifications"]}, "then": {"required": ["notifications_unknown_reason"]}},
          {"if": {"properties": {"capabilities": {"type": "null"}}, "required": ["capabilities"]}, "then": {"required": ["capabilities_unknown_reason"]}},
          {"if": {"properties": {"model_mappings": {"type": "null"}}, "required": ["model_mappings"]}, "then": {"required": ["model_mappings_unknown_reason"]}},
          {"if": {"properties": {"timing": {"type": "null"}}, "required": ["timing"]}, "then": {"required": ["timing_unknown_reason"]}},
          {"if": {"properties": {"release_behavior": {"type": "null"}}, "required": ["release_behavior"]}, "then": {"required": ["release_behavior_unknown_reason"]}}
        ],
        "properties": {
          "id": {"type": "string"},
          "reachability": {"type": "string"},
          "selectors": {"type": ["array", "null"]},
          "discovery_rules": {"type": ["object", "null"]},
          "gatt": {"type": ["object", "null"]},
          "session_sequence": {"type": ["array", "null"]},
          "packet_format": {"type": ["object", "null"]},
          "commands": {"type": ["array", "null"]},
          "notifications": {"type": ["array", "null"]},
          "capabilities": {"type": ["object", "null"]},
          "model_mappings": {"type": ["array", "null"]},
          "timing": {"type": ["object", "null"]},
          "release_behavior": {"type": ["object", "null"]},
          "evidence": {"type": "array"},
          "selectors_unknown_reason": {"type": "string", "minLength": 1},
          "discovery_rules_unknown_reason": {"type": "string", "minLength": 1},
          "gatt_unknown_reason": {"type": "string", "minLength": 1},
          "session_sequence_unknown_reason": {"type": "string", "minLength": 1},
          "packet_format_unknown_reason": {"type": "string", "minLength": 1},
          "commands_unknown_reason": {"type": "string", "minLength": 1},
          "notifications_unknown_reason": {"type": "string", "minLength": 1},
          "capabilities_unknown_reason": {"type": "string", "minLength": 1},
          "model_mappings_unknown_reason": {"type": "string", "minLength": 1},
          "timing_unknown_reason": {"type": "string", "minLength": 1},
          "release_behavior_unknown_reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "test_vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "protocol", "action", "inputs", "expected_bytes", "evidence"],
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "paths"],
        "additionalProperties": true
      }
    },
    "completion_gates": {
      "type": "array",
      "comment": "minItems and maxItems both equal the gate count, so with the contains clauses below every gate appears exactly once and cannot be reported twice with conflicting results.",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": ["gate", "result", "evidence"],
        "properties": {
          "gate": {"$ref": "#/$defs/gate_id"},
          "result": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}
        },
        "additionalProperties": true
      },
      "allOf": [
        {"contains": {"properties": {"gate": {"const": "identity_verified"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "stack_coverage"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "artifact_inventory"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "decompiler_warnings_resolved"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "search_passes_recorded"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "transport_callsites_dispositioned"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "protocol_candidates_dispositioned"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "control_actions_traced"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "command_rows_complete"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "test_vectors_reproducible"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "feature_domains_searched"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "second_pass_clean"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "variant_reconciliation"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "schema_validation"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "report_agreement"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "cleanroom_isolation"}}, "required": ["gate"]}},
        {"contains": {"properties": {"gate": {"const": "uncertainties_actionable"}}, "required": ["gate"]}}
      ]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "deferred_external_validation": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "comment": "Identity verification either succeeded or the run stopped as INPUT_MISMATCH. Anything that got past it must carry a real signer hash, artifact-set hash, and at least one application stack.",
      "if": {
        "properties": {"status": {"not": {"const": "INPUT_MISMATCH"}}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "artifact": {
            "properties": {
              "artifact_set_sha256": {"type": "string"},
              "signer_certificate_sha256": {"type": "array", "minItems": 1}
            }
          },
          "application_stacks": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "COMPLETE"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blockers": {
            "comment": "An unresolved blocker and a COMPLETE status are contradictory: a resolved historical constraint belongs in limitations.",
            "maxItems": 0
          },
          "completion_gates": {
            "items": {
              "allOf": [
                {"properties": {"result": {"enum": ["PASS", "NOT_APPLICABLE"]}}},
                {
                  "if": {
                    "properties": {"result": {"const": "NOT_APPLICABLE"}},
                    "required": ["result"]
                  },
                  "then": {
                    "properties": {"gate": {"$ref": "#/$defs/conditional_gate_id"}}
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "gate_id": {
      "enum": [
        "identity_verified",
        "stack_coverage",
        "artifact_inventory",
        "decompiler_warnings_resolved",
        "search_passes_recorded",
        "transport_callsites_dispositioned",
        "protocol_candidates_dispositioned",
        "control_actions_traced",
        "command_rows_complete",
        "test_vectors_reproducible",
        "feature_domains_searched",
        "second_pass_clean",
        "variant_reconciliation",
        "schema_validation",
        "report_agreement",
        "cleanroom_isolation",
        "uncertainties_actionable"
      ]
    },
    "conditional_gate_id": {
      "comment": "Gates that can legitimately not apply to an artifact. Every other gate must PASS for COMPLETE.",
      "enum": ["decompiler_warnings_resolved", "variant_reconciliation"]
    }
  },
  "additionalProperties": true
}
